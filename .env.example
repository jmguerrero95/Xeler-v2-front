# Frontend environment template.
# Vite variables are bundled into browser code; never put private secrets here.

VITE_API_URL=http://127.0.0.1:8000/api

# Public Pusher browser configuration. The auth URL must be the official backend /api/pusher/auth endpoint.
VITE_PUSHER_APP_KEY=
VITE_PUSHER_CLUSTER=
VITE_PUSHER_HOST=
VITE_PUSHER_PORT=
VITE_PUSHER_SCHEME=
VITE_BROADCAST_AUTH_URL=

# Public browser key only. Restrict this key by domain/API in Google Cloud.
VITE_API_GOOGLE=
VITE_TURNSTILE_SITE_KEY=

# Las operaciones protegidas requieren completar la verificacion telefonica.
VITE_IDENTITY_PHONE_VERIFICATION_REQUIRED=true

# Production address validation. Testnet values are restricted to automated tests.
VITE_ENV_NETWORK=prod
