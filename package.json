    "pusher-js": "^8.4.0",
    "qrcode.vue": "^3.8.0",
    "tsparticles-engine": "^2.12.0",
    "tsparticles-slim": "^2.12.0",
    "vite-plugin-vuetify": "^2.1.3",
    "vue": "^3.5.30",
    "vue-i18n": "^11.3.0",
