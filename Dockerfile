FROM node:22-alpine AS build

WORKDIR /app

RUN npm install --global npm@11.11.0

ARG VITE_API_URL
ARG VITE_PUSHER_APP_KEY
ARG VITE_PUSHER_CLUSTER
ARG VITE_PUSHER_HOST
ARG VITE_PUSHER_PORT
ARG VITE_PUSHER_SCHEME
ARG VITE_BROADCAST_AUTH_URL
ARG VITE_API_GOOGLE
ARG VITE_ENV_NETWORK=prod
ARG VITE_ORDER_TRACKING_POLL_INTERVAL_MS=15000
ARG VITE_IDENTITY_PHONE_VERIFICATION_REQUIRED=true
ARG VITE_TURNSTILE_SITE_KEY
ARG NODE_OPTIONS=--max-old-space-size=3072

ENV VITE_API_URL=$VITE_API_URL \
    VITE_PUSHER_APP_KEY=$VITE_PUSHER_APP_KEY \
    VITE_PUSHER_CLUSTER=$VITE_PUSHER_CLUSTER \
    VITE_PUSHER_HOST=$VITE_PUSHER_HOST \
    VITE_PUSHER_PORT=$VITE_PUSHER_PORT \
    VITE_PUSHER_SCHEME=$VITE_PUSHER_SCHEME \
    VITE_BROADCAST_AUTH_URL=$VITE_BROADCAST_AUTH_URL \
    VITE_API_GOOGLE=$VITE_API_GOOGLE \
    VITE_ENV_NETWORK=$VITE_ENV_NETWORK \
    VITE_ORDER_TRACKING_POLL_INTERVAL_MS=$VITE_ORDER_TRACKING_POLL_INTERVAL_MS \
    VITE_IDENTITY_PHONE_VERIFICATION_REQUIRED=$VITE_IDENTITY_PHONE_VERIFICATION_REQUIRED \
    VITE_TURNSTILE_SITE_KEY=$VITE_TURNSTILE_SITE_KEY \
    NODE_OPTIONS=$NODE_OPTIONS

COPY package.json package-lock.json ./
RUN npm ci --legacy-peer-deps --no-audit --no-fund

COPY . .
RUN node scripts/validate-production-build-env.mjs && npm run typecheck && npm run build

FROM nginx:1.28-alpine AS runtime

COPY --from=build /app/dist /usr/share/nginx/html
COPY default-nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://127.0.0.1:8080/healthz || exit 1

CMD ["nginx", "-g", "daemon off;"]
